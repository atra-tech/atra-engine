TARGET=atra-engine

CC=x86_64-w64-mingw32-gcc

SRC=src
OBJ=obj-w32
EXEC_SRC=exec
BUILD_DIR=win32

SRCS=$(wildcard $(SRC)/*.c)
OBJS=$(patsubst $(SRC)/%.c, $(OBJ)/%.o, $(SRCS))
EXEC_SRCS=$(wildcard $(EXEC_SRC)/*.c)

TEST=test
TESTS=$(wildcard $(TEST)/*.c)
TESTBINS=$(patsubst $(TEST)/%.c, $(TEST)/bin/%, $(TESTS))
TESTASMS=$(patsubst $(TEST)/bin/%, $(TEST)/asm/%.s, $(TESTBINS))

TARGET_PATH=$(BUILD_DIR)/$(TARGET).exe

LIBDIR=lib-w32
LIB=$(LIBDIR)/libatra-w32.a

INC_DIRS=$(shell find $(SRC) -type d)
INC_FLAGS=$(addprefix -I,$(INC_DIRS))

LDFLAGS=-L. -L./win32 -static-libgcc -lmingw32 -lm -lSDL2 -lSDL2main -lSDL2_image -lSDL2_net -lopengl32 -lOpenAL32 -pthread -Wl,-subsystem,windows
CFLAGS=$(INC_FLAGS) -I./include/ -I./vendor/cglm/include/ -MP -MMD -O2 -Wall -Wextra -Wpedantic -g -std=c99

$(TARGET_PATH): $(LIB) $(BUILD_DIR) $(EXEC_SRCS)
	$(CC) $(CFLAGS) $(SRCS) $(EXEC_SRCS) -o $@ $(LDFLAGS)

.PHONY: all release test clean

all: $(LIB)

release: CFLAGS=-Wall -O2 -DNDEBUG
release: clean
release: $(LIB)

$(LIB): $(LIBDIR) $(OBJ) $(OBJS)
	$(RM) $(LIB)
	x86_64-w64-mingw32-ar -cvrs $(LIB) $(OBJS)

$(OBJ)/%.o: $(SRC)/%.c $(SRC)/%.h
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ)/%.o: $(SRC)/%.c
	$(CC) $(CFLAGS) -c $< -o $@

$(TEST)/bin:
	mkdir $@

$(TEST)/asm:
	mkdir $@

$(TEST)/bin/%: $(TEST)/%.c
	$(CC) $(CFLAGS) $< $(OBJS) -o $@ $(LDFLAGS) -lcheck

$(TEST)/asm/%.s: $(TEST)/%.c
	$(CC) $(CFLAGS) -S $< $(OBJS) -o $@ $(LDFLAGS) -lcheck

$(OBJ):
	mkdir $@

$(LIBDIR):
	mkdir $@

$(BUILD_DIR):
	mkdir $@

$(EXEC_SRC):
	mkdir $@

test: clean $(LIB) $(TEST)/bin $(TEST)/asm $(TESTBINS) $(TESTASMS) 
	for test in $(TESTBINS) ; do ./$$test ; done

clean:
	$(RM) -r $(LIB) $(OBJ) $(TARGET_PATH) $(TEST)/bin $(TEST)/asm
